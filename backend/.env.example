APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aeos
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
AI_PROVIDER=placeholder

# AI feedback drafting (server-side only; never expose these to the browser).
# OFF by default. Synthetic responses only in this phase.
AEOS_AI_FEEDBACK_ENABLED=false
AEOS_AI_FEEDBACK_PROVIDER=anthropic
# No default model: set an ID your provider account lists. It is checked
# against the provider's live model list (and structured-output support) before use.
AEOS_AI_FEEDBACK_MODEL=
AEOS_AI_FEEDBACK_API_KEY=
AEOS_AI_FEEDBACK_BASE_URL=https://api.anthropic.com
AEOS_AI_FEEDBACK_TIMEOUT_SECONDS=30
AEOS_AI_FEEDBACK_MAX_RETRIES=2
AEOS_AI_FEEDBACK_MAX_OUTPUT_TOKENS=4096
# Current USD per million tokens for the configured model (required, no default).
AEOS_AI_FEEDBACK_INPUT_USD_PER_MTOK=
AEOS_AI_FEEDBACK_OUTPUT_USD_PER_MTOK=
# Comma-separated organization UUIDs allowed to use the feature.
AEOS_AI_FEEDBACK_ORG_ALLOWLIST=
# Comma-separated "<rubric_id>@<version>:<sha256>" pins set by a human approver.
AEOS_AI_FEEDBACK_APPROVED_RUBRICS=
AEOS_AI_FEEDBACK_USER_HOURLY_REQUESTS=10
AEOS_AI_FEEDBACK_ORG_DAILY_REQUESTS=100
AEOS_AI_FEEDBACK_USER_DAILY_COST_MICROUSD=1000000
AEOS_AI_FEEDBACK_ORG_DAILY_COST_MICROUSD=5000000
