# ELA AI Pilot — local configuration.
# Copy to `.env.local`. Never commit real keys.

# Scoring provider: `mock` (default, deterministic, no network) or `openai`.
# The pilot runs on `mock` by design — see CLAUDE.md, non-goals.
SCORING_PROVIDER=mock

# Version strings pinned onto every scoring run. Change these whenever the
# model or the prompt changes, so runs stay comparable and auditable.
SCORING_MODEL_VERSION=mock-1.0.0
SCORING_PROMPT_VERSION=rubric-v1

# Only read when SCORING_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# SQLite file. Defaults to ./pilot.db.
# PILOT_DB_PATH=./pilot.db
