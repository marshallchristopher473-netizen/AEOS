# Frontend environment template.
#
# Only publishable values belong here. NEXT_PUBLIC_* variables are inlined into
# the browser bundle. The Supabase service-role key is server-only and must
# never be added to this file or to any NEXT_PUBLIC_* variable.

# Base URL of the AEOS FastAPI backend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase project URL and publishable anon key, used for user sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
