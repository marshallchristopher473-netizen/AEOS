# Copy to frontend/.env.local and fill in values from your Supabase project
# (Project Settings -> API). These are PUBLIC values shipped to the browser.
# Never put the service-role key in the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Next.js proxies /api requests to this backend (server-side only). Keep
# browser requests same-origin; do not point the browser at the backend.
AEOS_API_URL=http://127.0.0.1:8000
