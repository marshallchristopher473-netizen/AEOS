{
  "name": "AEOS canonical workstation",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [8000, 3000],
  "portsAttributes": {
    "8000": { "label": "AEOS backend (FastAPI)" },
    "3000": { "label": "AEOS frontend (Next.js)" }
  },
  "postCreateCommand": "bash scripts/verify_environment.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
